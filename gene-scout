#!/bin/bash
set -euo pipefail

usage() {
    echo ""
    echo "GENE-SCOUT: Gene-centric mutation detection pipeline"
    echo ""
    echo "Usage:"
    echo "  gene-scout --genomes DIR --ancestors DIR --out DIR [options]"
    echo ""
    echo "Required:"
    echo "  --genomes    DIR   Directory of genome assemblies"
    echo "  --ancestors  DIR   WT gene CDS FASTA directory"
    echo "  --out        DIR   Output directory"
    echo ""
    echo "Optional:"
    echo "  --mutations  TSV   Mutation list"
    echo "  --threads    N     Number of threads (default: 4)"
    echo ""
    exit 1
}

# ============================================================
# PARSE ARGUMENTS
# ============================================================

GENOMES=""
ANCESTORS=""
OUT=""
MUTATIONS=""
THREADS="4"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --genomes)   GENOMES="$2";   shift 2 ;;
        --ancestors) ANCESTORS="$2"; shift 2 ;;
        --out)       OUT="$2";       shift 2 ;;
        --mutations) MUTATIONS="$2"; shift 2 ;;
        --threads)   THREADS="$2";   shift 2 ;;
        -h|--help)   usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

[[ -z "$GENOMES"   ]] && { echo "ERROR: --genomes required";   usage; }
[[ -z "$ANCESTORS" ]] && { echo "ERROR: --ancestors required"; usage; }
[[ -z "$OUT"       ]] && { echo "ERROR: --out required";       usage; }

[[ -d "$GENOMES"   ]] || { echo "ERROR: genomes dir not found"; exit 1; }
[[ -d "$ANCESTORS" ]] || { echo "ERROR: ancestors dir not found"; exit 1; }

# ✅ Validate mutation file
if [ -n "$MUTATIONS" ] && [ ! -f "$MUTATIONS" ]; then
    echo "ERROR: mutation list not found: $MUTATIONS"
    exit 1
fi

# ✅ Validate threads
if ! [[ "$THREADS" =~ ^[0-9]+$ ]]; then
    echo "ERROR: --threads must be an integer"
    exit 1
fi

# ============================================================
# PATHS
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS="$SCRIPT_DIR/scripts"

export BASE="$(cd "$OUT" && pwd 2>/dev/null || echo "$OUT")"
export GENOME_FASTA_DIR="$(cd "$GENOMES" && pwd)"
export WT_GENES="$(cd "$ANCESTORS" && pwd)"
export MUTATION_LIST="${MUTATIONS:-}"
export THREADS="$THREADS"

mkdir -p "$BASE"

# ============================================================
# DEPENDENCY CHECK
# ============================================================

for cmd in minimap2 seqkit macse python; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "ERROR: Missing dependency: $cmd"
        exit 1
    fi
done

# ============================================================
# CONFIG PRINT
# ============================================================

echo ""
echo "══════════════════════════════════════════"
echo "  GENE-SCOUT"
echo "══════════════════════════════════════════"
echo "Genomes:   $GENOME_FASTA_DIR"
echo "Ancestors: $WT_GENES"
echo "Output:    $BASE"
echo "Threads:   $THREADS"
[ -n "$MUTATION_LIST" ] && echo "Mutations: $MUTATION_LIST"
echo "══════════════════════════════════════════"
echo ""

# ============================================================
# RUN PIPELINE
# ============================================================

echo "── Step A: minimap2 alignment ─────────────"
bash "$SCRIPTS/minimap_loop.sh"

echo "── Step B: gene extraction ───────────────"
bash "$SCRIPTS/paf_loop.sh"

echo "── Step C: mutation pipeline ─────────────"
bash "$SCRIPTS/run_pipeline.sh"

# ============================================================

echo ""
echo "══════════════════════════════════════════"
echo "  ✅ GENE-SCOUT COMPLETE"
echo "  ➡  Output: $BASE"
echo "══════════════════════════════════════════"
echo ""
