#!/bin/bash
set -euo pipefail

usage() {
    echo ""
    echo "GENE-SCOUT: Gene-centric mutation detection pipeline"
    echo ""
    echo "Usage:"
    echo "  gene-scout --genomes DIR --ancestors DIR --out DIR"
    echo ""
    exit 1
}

GENOMES=""
ANCESTORS=""
OUT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --genomes)
            GENOMES="$2"; shift 2 ;;
        --ancestors)
            ANCESTORS="$2"; shift 2 ;;
        --out)
            OUT="$2"; shift 2 ;;
        *)
            usage ;;
    esac
done

[[ -z "$GENOMES" || -z "$ANCESTORS" || -z "$OUT" ]] && usage

export BASE="$(realpath "$OUT")"
export GENOME_FASTA_DIR="$(realpath "$GENOMES")"
export WT_GENES="$(realpath "$ANCESTORS")"

SCRIPTS="$(dirname "$(realpath "$0")")/scripts"

mkdir -p "$BASE"
cd "$BASE"

echo "Running minimap2 alignment"
bash "$SCRIPTS/minimap_loop.sh"

echo "Extracting CDS from PAF files"
bash "$SCRIPTS/paf_loop.sh"

echo "Running mutation detection pipeline"
bash "$SCRIPTS/run_pipeline.sh"

echo ""
echo "✅ GENE-SCOUT COMPLETE"
echo "➡ Results in: $BASE"
``
